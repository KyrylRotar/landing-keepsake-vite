header.header
  .container.header__inner
    a.logo(href='/landing-keepsake-vite/', aria-label='Keepsake home')
      include ../includes/logo
      span.logo__name Keepsake
    nav#site-navigation.header__nav(aria-label='Primary navigation')
      ul.header__list
        each item, i in navigation
          li.header__item
            a.header__link(href=item.href)= item.text
    +btn("Let's talk", '#contact').header__button.button--primary
    button.header__menu(
      type='button',
      aria-label='Open navigation',
      aria-controls='site-navigation',
      aria-expanded='false'
    )
      span
      span
      span
