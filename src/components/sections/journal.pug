section#journal.journal
  .container
    .section-heading
      p.section-heading__eyebrow Journal
      h2.section-heading__title Notes and observations
    ul.journal__list
      each post, i in journal
        li.journal__item
          article
            if i === 0
              +picture(post.image, post.title, 800, 632, true).journal__image
            else
              +picture(post.image, post.title, 800, 632).journal__image
            time.journal__date= post.date
            h3.journal__title= post.title
