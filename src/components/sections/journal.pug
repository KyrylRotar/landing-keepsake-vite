section#journal.journal(aria-labelledby='journal-title')
  .container.journal__container
    h2#journal-title.journal__title From the journal
    p.journal__intro Notes on process, case studies and things that inspire us.
    .journal__grid
      each post, i in journal
        article.journal-card
          a.journal-card__thumb(href='#contact', aria-label='Read: ' + post.title)
            +picture(post.image, '', 400, 400, i === 0)
          .journal-card__copy
            p.journal-card__meta
              time(datetime=post.datetime)= post.date
              span= post.category
            h3.journal-card__title
              a(href='#contact')= post.title
            p.journal-card__excerpt= post.excerpt
            a.journal-card__read-more(href='#contact') Read more
              span(aria-hidden='true') ›
