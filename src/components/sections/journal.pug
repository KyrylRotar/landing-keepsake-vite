section#journal.journal
  .container
    .journal__heading
      .section-heading
        p.section-heading__eyebrow Ideas, notes &amp; news
        h2.section-heading__title From the journal
      a.journal__all(href='#journal') View all articles
    ul.journal__list
      each post, i in journal
        li.journal__item
          article.journal-card
            a.journal-card__image(href='#journal', aria-label='Read ' + post.title)
              +picture(post.image, post.title, 800, 632, i === 0)
            time.journal-card__date(datetime=post.datetime)= post.date
            h3.journal-card__title
              a(href='#journal')= post.title
            p.journal-card__copy= post.excerpt
