section#about.services(aria-labelledby='services-title')
  .container.services__container
    h2#services-title.services__title What do we do
    p.services__intro We are a small team of designers and makers who help brands look their best online and offline.
    .services__grid
      each service in services
        article.service-card
          span.service-card__icon(aria-hidden='true')
            case service.icon
              when 'digital'
                svg.service-card__symbol(viewBox='0 0 48 48')
                  rect.icon__frame(x='8', y='12', width='32', height='24')
                  rect.icon__screen(x='13', y='17', width='22', height='14')
                  rect.icon__accent(x='16', y='20', width='9', height='8')
              when 'motion'
                svg.service-card__symbol(viewBox='0 0 48 48')
                  rect.icon__camera(x='7', y='11', width='34', height='26', rx='5')
                  rect.icon__screen(x='13', y='16', width='22', height='16', rx='3')
              when 'print'
                svg.service-card__symbol(viewBox='0 0 48 48')
                  rect.icon__stamp(x='14', y='12', width='20', height='17')
                  rect.icon__base(x='8', y='28', width='32', height='9', rx='2')
              default
                svg.service-card__symbol(viewBox='0 0 48 48')
                  path.icon__heart(d='M24 38 9 23.5C2 15 14 6 24 16 34 6 46 15 39 23.5L24 38Z')
          h3.service-card__title= service.title
          p.service-card__description= service.text
