footer#contact.contact
  .container.site-footer__container
    .site-footer__top
      .footer-links
        each column in footerColumns
          .footer-links__group
            h2.footer-links__title= column.title
            each link in column.links
              a.footer-links__link(href=link.href)= link.text
      form#newsletter.newsletter-form(action='#newsletter-success', method='get')
        h2.newsletter-form__title Newsletter
        p.newsletter-form__intro Fresh case studies and design notes, once a month.
        .newsletter-form__fields
          .newsletter-form__email-field
            label.visually-hidden(for='newsletter-email') Your email address
            input#newsletter-email.newsletter-form__input(
              type='email',
              placeholder='Your email address',
              autocomplete='email',
              required,
              aria-describedby='newsletter-error'
            )
            p#newsletter-error.newsletter-form__error Please enter a valid email address.
          label.newsletter-form__consent(for='newsletter-consent')
            input#newsletter-consent(type='checkbox', required)
            span I agree to the privacy policy
          button.button.button--primary.newsletter-form__submit(type='submit') Subscribe
        p#newsletter-success.newsletter-form__success(role='status')
          span.newsletter-form__success-check(aria-hidden='true') ✓
          span Thanks for your interest.
    .site-footer__bottom
      p.site-footer__copyright © #{ new Date().getFullYear() } Keepsake. All rights reserved.
      .social-links(role='group', aria-label='Social media')
        each social in socials
          a(class='social-links__link social-links__link--' + social.className, href=social.href, aria-label=social.label)= social.short
a.back-to-top(href='#top', aria-label='Back to top')
  svg.back-to-top__icon(viewBox='0 0 24 24', aria-hidden='true')
    path(d='m5 14 7-7 7 7M12 7v12')
