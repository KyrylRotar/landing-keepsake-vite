article.testimonial(aria-label='Client testimonial')
  svg.testimonial__quote-mark(viewBox='0 0 54 44', aria-hidden='true')
    path(
      d='M22 2C9 6 2 16 2 30v12h20V24h-9c1-5 5-9 11-12L22 2Zm27 0C36 6 29 16 29 30v12h20V24h-9c1-5 5-9 11-12l-2-10Z'
    )
  blockquote.testimonial__quote= testimonial.quote
  .testimonial__footer
    .testimonial__person
      span.testimonial__avatar(aria-hidden='true')= testimonial.initials
      span.testimonial__identity
        strong= testimonial.name
        small= testimonial.role
    .testimonial__dots(role='img', aria-label='Slide 1 of 3')
      span.testimonial__dot.testimonial__dot--current
      span.testimonial__dot
      span.testimonial__dot
