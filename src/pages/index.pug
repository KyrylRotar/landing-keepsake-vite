extends ../layouts/main

block append meta
  meta(name='theme-color', content='#ffffff')
  meta(
    name='description',
    content='Keepsake is an independent digital and branding agency making thoughtful identities, websites and printed things.'
  )
  meta(property='og:title', content='Keepsake — Digital & Branding Agency')
  meta(property='og:type', content='website')

block title
  title Keepsake — Digital & Branding Agency

block data
  include ../data/navigation
  include ../data/categories
  include ../data/works
  include ../data/services
  include ../data/stats
  include ../data/journal
  include ../data/footer
  include ../data/clients
  include ../data/testimonial

block append scripts
  script(type='module', src='/src/main.js')

block prepend styles
  link(rel='preconnect', href='https://fonts.googleapis.com')
  link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
  link(
    href='https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Open+Sans:wght@300;400;700&family=Oswald:wght@300;400;700&display=swap',
    rel='stylesheet'
  )

block header
  include ../components/header

block content
  include ../components/sections/hero
  include ../components/sections/works
  include ../components/sections/about
  include ../components/sections/services
  include ../components/sections/statistics
  include ../components/sections/clients
  include ../components/sections/journal

block footer
  include ../components/sections/contact
