{
  "name": "vite-pug-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');if(fs.existsSync('dist/index.pug.html'))fs.renameSync('dist/index.pug.html','dist/index.html')\"",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "images": "node scripts/generate-images.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.2",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "sharp": "^0.34.4",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  }
}
